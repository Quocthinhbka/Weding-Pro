# Sao chép thành file .env rồi điền giá trị: cp .env.example .env

# Tên miền đã trỏ bản ghi A về IP của VPS (không có https://)
DOMAIN=ten-mien-cua-ban.vn

# Địa chỉ đầy đủ của trang, dùng để tạo link mời và ảnh xem trước khi chia sẻ
PUBLIC_SITE_URL=https://ten-mien-cua-ban.vn

# Mã đăng nhập trang quản trị /admin (bắt buộc). Chưa đặt thì không đăng nhập được.
ADMIN_PASSWORD=

# Chuỗi ngẫu nhiên tối thiểu 32 ký tự để ký phiên đăng nhập.
# Tạo nhanh bằng lệnh: openssl rand -base64 32
SESSION_SECRET=

# Mã 4 số để xem clip riêng tư ở trang /wedmemo. Chưa đặt thì không ai mở khoá được.
WEDMEMO_CODE=
